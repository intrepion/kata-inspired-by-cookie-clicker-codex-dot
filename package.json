    "check": "npm run test && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
